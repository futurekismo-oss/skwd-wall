settings-general-general-card = عمومی
settings-general-monitor-label = پکر مانیٹر
settings-general-monitor-desc = ایک ڈسپلے منتخب کریں، یا پکر کھلنے پر جو مانیٹر فوکس میں ہو وہ استعمال کریں۔ اسے بدلنے کے بعد پکر بند کر کے دوبارہ کھولیں۔
settings-general-monitor-focused = فوکس شدہ مانیٹر
settings-general-monitor-unavailable = { $output } (دستیاب نہیں)
settings-general-ui-scale-label = UI اسکیل
settings-general-ui-scale-desc = پکر کے پورے انٹرفیس کو اسکیل کریں۔ حد 0.5 سے 2.0 تک ہے۔
settings-general-features-card = خصوصیات
settings-general-features-card-desc = اختیاری انضمام آن یا آف کریں۔ ہر فعال انضمام کی تفصیلی ترتیبات اس کے اپنے ٹیب میں ہیں۔
settings-general-feature-matugen-label = Matugen
settings-general-feature-matugen-desc = وال پیپر کے رنگوں کے لیے Matugen استعمال کریں۔ بند کرنے پر بلٹ ان Iris استعمال ہوگا۔
settings-general-feature-steam-label = Steam Workshop براؤزر
settings-general-feature-steam-desc = Steam Workshop سے Wallpaper Engine آئٹم براؤز اور انسٹال کریں۔
settings-general-feature-wallhaven-label = Wallhaven براؤزر
settings-general-feature-wallhaven-desc = wallhaven.cc سے وال پیپر براؤز اور ڈاؤن لوڈ کریں۔
settings-general-audio-card = آڈیو
settings-general-audio-card-desc = ویڈیو اور Wallpaper Engine وال پیپرز کے لیے ڈیفالٹ آڈیو مقرر کریں۔
settings-general-mute-label = وال پیپر آڈیو خاموش کریں
settings-general-mute-desc = ویڈیو اور Wallpaper Engine کی آڈیو آؤٹ پٹ خاموش کریں۔
settings-general-volume-label = وال پیپر والیوم
settings-general-volume-desc = ویڈیو اور Wallpaper Engine آڈیو کے پلے بیک کا والیوم (0-100)۔ آڈیو خاموش ہونے پر اس کا کوئی اثر نہیں ہوتا۔
settings-general-auto-recolour-card = خودکار رنگ بدلنا
settings-general-auto-recolour-card-desc = نیا وال پیپر شامل ہونے پر پیلیٹ کے رنگوں والی نقل بنائیں۔ اصل فائل بدلے بغیر رکھی جاتی ہے۔
settings-general-auto-recolour-label = نئے وال پیپرز کا رنگ خود بخود بدلیں
settings-general-auto-recolour-desc = ہر نئے وال پیپر کے ساتھ بدلے ہوئے رنگوں والی نقل محفوظ کریں۔ اگر آپ صرف اصل فائل چاہتے ہیں تو اسے بند کریں۔
settings-general-recolour-theme-label = رنگ بدلنے کی تھیم
settings-general-recolour-theme-desc = نئے وال پیپرز کا رنگ خود بخود بدلتے وقت استعمال ہونے والا پیلیٹ۔
settings-general-behaviour-card = رویہ
settings-general-close-on-selection-label = انتخاب پر بند کریں
settings-general-close-on-selection-desc = وال پیپر لاگو کرتے ہی سلیکٹر چھپا دیں۔
settings-general-hover-selects-label = ہوور پر منتخب کریں
settings-general-hover-selects-desc = انتخاب کو پوائنٹر کے نیچے والے کارڈ پر لے جاتا ہے۔ بند کرنے پر صرف کلک اور کلیدوں سے انتخاب ہوگا۔
settings-general-notify-label = وال پیپر بدلنے پر اطلاع دیں
settings-general-notify-desc = ہر بار وال پیپر بدلنے پر سسٹم اطلاع بھیجیں۔
settings-general-restore-label = شروع ہونے پر وال پیپر بحال کریں
settings-general-restore-desc = ڈیمن شروع ہونے پر آخری وال پیپر دوبارہ لاگو کریں۔
settings-general-random-card = بے ترتیب گردش
settings-general-rotate-label = خود بخود گردش کریں
settings-general-rotate-desc = وقفہ ختم ہونے پر نیچے دیے گئے پول سے بے ترتیب وال پیپر لاگو کریں۔ یہ بند ہونے پر وقفہ کچھ نہیں کرتا۔
settings-general-interval-label = وقفہ
settings-general-interval-desc = بے ترتیب گردشوں کے درمیان سیکنڈ (کم از کم 10)۔
settings-general-include-images-label = تصاویر شامل کریں
settings-general-include-images-desc = بے ترتیب پول میں ساکن وال پیپرز کی اجازت دیں۔
settings-general-include-video-label = ویڈیو شامل کریں
settings-general-include-video-desc = بے ترتیب پول میں ویڈیو وال پیپرز کی اجازت دیں۔
settings-general-include-we-label = Wallpaper Engine شامل کریں
settings-general-include-we-desc = بے ترتیب پول میں Wallpaper Engine آئٹمز کی اجازت دیں۔
settings-general-favourites-only-label = صرف پسندیدہ
settings-general-favourites-only-desc = بے ترتیب پول کو پسندیدہ وال پیپرز تک محدود کریں۔

settings-general-apply-picker-monitor-label = صرف پکر مانیٹر پر لاگو کریں
settings-general-apply-picker-monitor-desc = وال پیپر اس مانیٹر پر لاگو کریں جہاں یہ پکر کھلا۔ ڈسپلے منتخب کریں سے پھر بھی دوسرے مانیٹر چنے جا سکتے ہیں۔
status-picker-monitor-unavailable = پکر مانیٹر دستیاب نہیں۔ پکر دوبارہ کھولیں یا ڈسپلے منتخب کریں استعمال کریں۔
settings-general-other-audio-label = جب دوسری ایپس آواز چلائیں تو وال پیپر کی آواز روکیں
settings-general-other-audio-desc = جب بھی کوئی دوسری ایپلیکیشن آواز چلائے تو ویڈیو اور Wallpaper Engine کی آواز خاموش کر دیتا ہے اور اس کے رکنے کے تقریباً ایک سیکنڈ بعد واپس لاتا ہے۔ pactl کمانڈ کے ساتھ PipeWire یا PulseAudio درکار ہے۔ خاموشی اور آواز کی سطح کی ترتیبات جوں کی توں رہتی ہیں۔
settings-general-other-audio-ducked = وال پیپر کی آواز رکی ہوئی ہے: ایک اور ایپلیکیشن آواز چلا رہی ہے
settings-general-other-audio-listening = دوسری ایپلیکیشنز کی آواز سنی جا رہی ہے
settings-general-other-audio-unavailable = ساؤنڈ سرور کی شناخت دستیاب نہیں۔ دیکھیں کہ pactl نصب ہے اور PipeWire یا PulseAudio چل رہا ہے۔
