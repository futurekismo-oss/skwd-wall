settings-selector-layout-card = लेआउट
settings-selector-display-mode-label = डिस्प्ले मोड
settings-selector-display-mode-desc = चुनें कि पिकर में वॉलपेपर कार्ड कैसे सजाए जाएँ।
settings-selector-filter-motion-label = फ़िल्टर गति
settings-selector-filter-motion-desc = फ़िल्टर परिणाम बदलने पर रोल कितनी तेज़ी से चलता है। तीनों साझा वेट Motion सेटिंग्स में हैं।
settings-selector-presets-card = प्रीसेट
settings-selector-presets-card-desc = वर्तमान लेआउट सेटिंग्स सहेजें या कोई सहेजा हुआ सेट लागू करें। हर डिस्प्ले मोड के अपने प्रीसेट होते हैं।
settings-selector-preset-name-label = नाम
settings-selector-preset-name-desc = चुने हुए प्रीसेट का नाम बदलें। वर्तमान सहेजें से स्वचालित नाम वाला नया प्रीसेट बनता है।
settings-selector-preset-name-placeholder = स्टाइल का नाम
settings-selector-preset-generated-name = स्टाइल { $number }
settings-selector-saved-styles-label = सहेजी गई स्टाइलें
settings-selector-live-preview-card = रंग पूर्वावलोकन
settings-selector-live-preview-label = होवर पर थीम का पूर्वावलोकन
settings-selector-live-preview-desc = पॉइंटर के नीचे वाले वॉलपेपर से पिकर को फिर से रंगें। पॉइंटर हटने पर वर्तमान थीम लौट आती है, जब तक आप लागू न करें।
settings-selector-type-badges-label = प्रकार बैज दिखाएँ
settings-selector-type-badges-desc = वॉलपेपर कार्ड पर Pic, Vid या WE का चिह्न लगाएँ ताकि कार्ड खोले बिना फ़ाइल का प्रकार दिखे।
settings-selector-composition-card = संरचना
settings-selector-composition-card-desc-hex = फ़ील्ड का समग्र आकार चुनें, फिर उसका मोड़, टाइल आकार, पंक्तियाँ और स्तंभ समायोजित करें।
settings-selector-composition-card-desc-wall = कोई Wall लेआउट चुनें, फिर उसका घनत्व, अंतराल और कार्ड समायोजित करें।
settings-selector-hex-curve-label = Geometric मोड
settings-selector-hex-curve-desc = चुनें कि पूरा फ़ील्ड समतल रहे या चाप, लहर, S आकार या सिलिंडर में मुड़े।
settings-selector-hex-curve-flat = समतल
settings-selector-hex-curve-arc = धनुष
settings-selector-hex-curve-wave = रिबन
settings-selector-hex-curve-s = S मोड़
settings-selector-hex-curve-cylinder = सिलिंडर
settings-selector-hex-shape-label = टाइल परिवार
settings-selector-hex-shape-desc = कोई टेसेलेटिंग टाइल चुनें। हीरा और समचतुर्भुज एक वॉलपेपर को ऊर्ध्वाधर या क्षैतिज ज्यामिति में लपेटते हैं।
settings-selector-hex-shape-triangle = त्रिभुज
settings-selector-hex-shape-hexagon = षट्भुज
settings-selector-hex-shape-diamond = हीरा
settings-selector-hex-shape-rhombus = समचतुर्भुज
settings-selector-hex-intensity-label = मोड़ की तीव्रता
settings-selector-hex-intensity-desc = चुने हुए फ़ील्ड आकार को और अधिक मोड़ने के लिए दाईं ओर खिसकाएँ।
settings-selector-hex-waves-label = लहरें
settings-selector-hex-waves-desc = फ़ील्ड के आर-पार कितनी रिबन लहरें जाती हैं।
settings-selector-hex-orbit-radius-label = सिलिंडर त्रिज्या
settings-selector-hex-orbit-radius-desc = छोटे मान फ़ील्ड को और कसकर लपेटते हैं।
settings-selector-hex-rows-label = पंक्तियाँ
settings-selector-hex-cols-label = स्तंभ
settings-selector-cells-card = सेल
settings-selector-cells-card-desc = चुने हुए फ़ील्ड आकार को बदले बिना टाइल का आकार और अंतराल बदलें।
settings-selector-hex-cell-size-label = सेल आकार
settings-selector-hex-gap-x-label = क्षैतिज अंतराल
settings-selector-hex-gap-y-label = ऊर्ध्वाधर अंतराल
settings-selector-wall-mode-label = Wall मोड
settings-selector-wall-mode-desc = चुनें कि Wall कार्ड कैसे सजाए। हर मोड में पंक्ति का आकार और स्क्रॉल व्यवहार अलग होता है।
settings-selector-wall-mode-uniform = एकसमान
settings-selector-wall-mode-brick = ईंट
settings-selector-wall-mode-masonry = चिनाई
settings-selector-wall-mode-justified = जस्टिफ़ाइड
settings-selector-wall-mode-editorial = एडिटोरियल
settings-selector-wall-mode-cylinder = सिलिंडर
settings-selector-grid-columns-label = स्तंभ
settings-selector-grid-rows-label = पंक्तियाँ
settings-selector-grid-stagger-label = संतुलन
settings-selector-grid-stagger-desc = एकांतर पंक्तियों का ऑफ़सेट बदलें, या एडिटोरियल मोड में मुख्य कार्ड का आकार।
settings-selector-grid-bend-label = वक्रता
settings-selector-grid-bend-desc = धनात्मक मान दूर की ओर लपेटता है; ऋणात्मक मान आपकी ओर झुकता है।
settings-selector-grid-cylinder-radius-label = सिलिंडर त्रिज्या
settings-selector-grid-cylinder-radius-desc = छोटे मान लपेट को और कसते हैं।
settings-selector-cards-card = कार्ड
settings-selector-cards-card-desc = कार्ड का आकार, अंतराल और कोनों की बनावट समायोजित करें।
settings-selector-card-width-label = कार्ड चौड़ाई
settings-selector-card-height-label = कार्ड ऊँचाई
settings-selector-grid-gap-x-label = क्षैतिज अंतराल
settings-selector-grid-gap-x-desc = स्तंभों के बीच किनारे से किनारे तक दिखने वाली जगह।
settings-selector-grid-gap-y-label = ऊर्ध्वाधर अंतराल
settings-selector-grid-gap-y-desc = पंक्तियों के बीच किनारे से किनारे तक दिखने वाली जगह।
settings-selector-grid-round-label = गोल कोने
settings-selector-grid-round-desc = बंद होने पर हर Wall कार्ड में सीधे कोने होते हैं।
settings-selector-grid-corner-radius-label = कोने की त्रिज्या
settings-selector-grid-corner-radius-desc = गोल कोने चालू होने पर उपयोग की जाने वाली गोलाई।
settings-selector-performance-card = प्रदर्शन
settings-selector-performance-card-desc = हर कण अलग ज्यामिति है। बड़े कण मतलब कम आकृतियाँ और GPU पर बहुत कम काम।
settings-selector-sand-note-discrete = पहचाने गए डिस्क्रीट GPU के लिए यह लोड कम है। यही कण आकार इंटीग्रेटेड GPU पर लगभग 150 गुना धीमा हो सकता है।
settings-selector-sand-note-integrated = इस इंटीग्रेटेड GPU पर Sand GPU-सीमित हो सकता है। कण आकार बढ़ाएँ या स्वचालित गति विवरण चालू रखें।
settings-selector-sand-meter-label = { $count } कण/फ़्रेम  ·  { $load }
settings-selector-sand-meter-desc = सामान्य केंद्र छवि पर कण { $grain } · { $card } ({ $tier }) · { $note }
settings-selector-sand-load-very-heavy = बहुत भारी
settings-selector-sand-load-heavy = भारी
settings-selector-sand-load-moderate = मध्यम
settings-selector-sand-load-light = हल्का
settings-selector-grain-size-label = कण आकार
settings-selector-grain-size-desc = पिक्सेल में कण का आकार। 1 का अर्थ है छवि के हर पिक्सेल पर एक कण और यह सबसे भारी है; बड़े कण मोटे दिखते हैं पर बहुत कम लागत लेते हैं।
settings-selector-render-scale-label = रेंडर स्केल
settings-selector-render-scale-desc = रेत को कम रिज़ॉल्यूशन पर रेंडर करके बड़ा करें। कण आकार से कम बचत होती है, क्योंकि कण पिक्सेल नहीं बल्कि ज्यामिति हैं।
settings-selector-lod-auto-label = स्वचालित गति विवरण
settings-selector-lod-auto-desc = तेज़ स्क्रॉल के दौरान कण आकार बढ़ाएँ। इंटीग्रेटेड GPU पर डिफ़ॉल्ट रूप से चालू, जहाँ यह गति की लागत लगभग 3.5 गुना घटाता है।
settings-selector-lod-strength-label = गति विवरण तीव्रता
settings-selector-lod-strength-desc = गति विवरण चलने पर पूरी स्क्रॉल गति पर अधिकतम कण गुणक।
settings-selector-sandy-card = Sandy
settings-selector-sandy-card-desc = वर्तमान वॉलपेपर गोल थंबनेल की पंक्ति के ऊपर केंद्र में रहता है। दूसरा चुनने पर दोनों छवियाँ कणों में बिखरकर विपरीत किनारों से बाहर जाती और अंदर आती हैं।
settings-selector-sandy-center-label = केंद्र ऊँचाई
settings-selector-sandy-slice-height-label = स्लाइस ऊँचाई
settings-selector-sandy-slice-width-label = स्लाइस चौड़ाई
settings-selector-sandy-gap-label = अंतराल
settings-selector-sandy-gap-desc = तिरछी स्लाइसों के बीच उनके ऊर्ध्वाधर मध्य बिंदु पर अंतराल। 0 पर किनारे छूते हैं; ऋणात्मक मान ओवरलैप करते हैं।
settings-selector-sandy-skew-label = तिरछापन
settings-selector-sandy-edge-speed-label = किनारा स्क्रॉल
settings-selector-sandy-edge-speed-desc = स्क्रीन के किनारों पर कैरोसेल पैन गति, 100 = डिफ़ॉल्ट।
settings-selector-sand-card = रेत
settings-selector-sand-card-desc = कण कैसे चलते हैं। सभी प्रतिशत में, 100 = डिफ़ॉल्ट।
settings-selector-sandy-duration-label = अवधि
settings-selector-sandy-duration-desc = पुरानी छवि के जाना शुरू करने से नई छवि के पूरी तरह बनने तक का कुल समय।
settings-selector-sandy-blend-label = मिश्रण
settings-selector-sandy-blend-desc = रंग स्वीप की लंबाई; रिंग फ़ेड इसके आधे पर चलते हैं।
settings-selector-sandy-strands-label = रिबन
settings-selector-sandy-strands-desc = कणों को अधिक या कम दिखने वाली धाराओं में बाँटें।
settings-selector-sandy-twist-label = ऐंठन
settings-selector-sandy-twist-desc = हर रिबन के साथ पेचदार घुमाव की तीव्रता।
settings-selector-sandy-orbit-label = कक्षा
settings-selector-sandy-orbit-desc = कण अपने रिबन के चारों ओर कितने चौड़े घेरे में घूमते हैं।
settings-selector-sandy-turbulence-label = अशांति
settings-selector-sandy-turbulence-desc = रिबन पथों का यादृच्छिक मरोड़।
settings-selector-sandy-waist-label = कमर
settings-selector-sandy-waist-desc = उड़ान के बीच में धाराओं का सिकुड़ना; कम = संकरा गला।
settings-selector-sandy-front-label = अग्रभाग
settings-selector-sandy-front-desc = पुरानी छवि के अलग-अलग हिस्सों के जाने का क्रम। अधिक मान बाद के क्षेत्रों को अधिक देर तक रोके रखते हैं।
settings-selector-sandy-fan-label = फैलाव
settings-selector-sandy-fan-desc = किनारों पर धारा का फैलाव, या भँवर मोड में घुमाव।
settings-selector-swap-style-label = स्वैप शैली
settings-selector-swap-style-desc = पुरानी और नई छवि के बीच कणों का पथ चुनें।
settings-selector-sandy-arc-label = चाप
settings-selector-sandy-arc-desc = कोना-लूप स्वैप चालू होने पर लूप का आकार।
settings-selector-swap-loop-label = कोना-लूप स्वैप
settings-selector-swap-loop-desc = बीच में चुनने पर कण घूमती रिंग में उठने के बजाय ऊपरी कोने से लूप करते हैं।
settings-selector-outgoing-live-label = जाता हुआ वीडियो चलता रहे
settings-selector-outgoing-live-desc = पुराना वीडियो रेत में बदलते समय चलता रहे। वीडियो-से-वीडियो बदलाव ट्रांज़िशन खत्म होने तक दूसरा डिकोडर चलाते हैं; बंद होने पर बिना अतिरिक्त लागत के जमा हुआ फ़्रेम रहता है।
settings-selector-ring-card = रिंग
settings-selector-ring-card-desc = ये सेटिंग्स वॉलपेपरों में तेज़ी से चलते समय दिखने वाली घूमती कण रिंग को नियंत्रित करती हैं। 100 मान डिफ़ॉल्ट है।
settings-selector-ring-size-label = आकार
settings-selector-ring-size-desc = मुख्य छवि के सापेक्ष कक्षा का व्यास। रिंग फिर भी मुख्य छवि के पहलू अनुपात का पालन करती है; 100 डिज़ाइन किया गया आकार रखता है।
settings-selector-ring-spin-label = घुमाव
settings-selector-ring-spin-desc = बैंड की कक्षीय गति।
settings-selector-ring-wave-label = लहर
settings-selector-ring-wave-desc = बैंड में फैलने वाली त्रिज्यीय लहर।
settings-selector-ring-soft-label = कोमलता
settings-selector-ring-soft-desc = अधिक मान बड़े, हल्के कण उपयोग करते हैं और रिंग को कम तीखा बनाते हैं।
settings-selector-ring-blend-label = रिंग मिश्रण
settings-selector-ring-blend-desc = रिंग के दौरान रंग स्वीप की लंबाई।
settings-selector-ring-hold-label = ठहराव विलंब
settings-selector-ring-hold-desc = अंतिम चयन के बाद रिंग मुख्य छवि पर टिकने से पहले कितनी देर रुके।
settings-selector-slice-size-card = स्लाइस आकार
settings-selector-slice-height-label = स्लाइस ऊँचाई
settings-selector-visible-count-label = दृश्य आइटम
settings-selector-expanded-width-label = चयनित चौड़ाई
settings-selector-slice-width-label = स्लाइस चौड़ाई
settings-selector-slice-gap-label = अंतराल
settings-selector-slice-gap-desc = तिरछी स्लाइसों के बीच उनके ऊर्ध्वाधर मध्य बिंदु पर अंतराल। 0 पर किनारे छूते हैं; ऋणात्मक मान ओवरलैप करते हैं।
settings-selector-skew-label = तिरछापन
settings-selector-edge-tilt-label = किनारा झुकाव
settings-selector-edge-tilt-desc = ऊपरी और निचले किनारों को तिरछा करें। धनात्मक मान दायाँ किनारा उठाते हैं; ऋणात्मक मान बायाँ किनारा उठाते हैं।
settings-selector-wobble-label = डगमगाहट
settings-selector-wobble-desc = कार्ड स्क्रॉल की दिशा में मुड़ते हैं और स्क्रॉल रुकने पर वापस उछलते हैं। तेज़ गति रंग चैनलों को भी अलग करती है।
settings-selector-wobble-strength-label = डगमगाहट तीव्रता
settings-selector-wobble-strength-desc = 100 मान डिफ़ॉल्ट है। 200 मान मोड़ और रंग विभाजन को दोगुना करता है।
settings-selector-corners-card = कोने
settings-selector-round-corners-label = गोल कोने
settings-selector-round-corners-desc = स्लाइस किनारों पर कोने की त्रिज्या लागू करें।
settings-selector-corner-tl-label = ऊपर-बाएँ
settings-selector-corner-tl-desc = ऊपर-बाएँ कोने की त्रिज्या। 0 = चौकोर।
settings-selector-corner-tr-label = ऊपर-दाएँ
settings-selector-corner-tr-desc = ऊपर-दाएँ कोने की त्रिज्या। 0 = चौकोर।
settings-selector-corner-br-label = नीचे-दाएँ
settings-selector-corner-br-desc = नीचे-दाएँ कोने की त्रिज्या। 0 = चौकोर।
settings-selector-corner-bl-label = नीचे-बाएँ
settings-selector-corner-bl-desc = नीचे-बाएँ कोने की त्रिज्या। 0 = चौकोर।
settings-selector-card-flip-card = कार्ड फ़्लिप
settings-selector-card-flip-card-desc = चुनें कि वॉलपेपर कार्ड अपने थंबनेल से पीछे के विवरण में कैसे बदले।
settings-selector-flip-effect-label = प्रभाव
settings-selector-flip-effect-desc = पहले चरण में उपयोग होने वाला थंबनेल शेडर।
settings-selector-flip-shader-label = थंबनेल शेडर
settings-selector-flip-shader-desc = थंबनेल प्रभाव छोड़कर सीधे पिछला भाग दिखाने के लिए बंद करें।
settings-selector-flip-back-label = पिछला भाग दिखाना
settings-selector-flip-back-desc = थंबनेल प्रभाव खत्म होने के बाद पिछले पैनल को तुरंत लाने के लिए बंद करें।
settings-selector-flip-duration-label = अवधि ओवरराइड
settings-selector-flip-duration-desc = कार्ड फ़्लिप का कुल समय। यह जानबूझकर साझा UI गति वेट को ओवरराइड करता है।
settings-selector-tag-cloud-card = खोज
settings-selector-tag-cloud-card-desc = पिकर के नीचे खुलने वाला टैग और वर्णन खोज पैनल।
settings-selector-tag-cloud-width-label = चौड़ाई
settings-selector-tag-cloud-width-desc = खोज पैनल की चौड़ाई।
settings-selector-tag-cloud-rows-label = क्लिक करने योग्य टैग पंक्तियाँ
settings-selector-tag-cloud-rows-desc = खोज फ़ील्ड के नीचे क्लिक करने योग्य सुझावों की कितनी पंक्तियाँ खुलें।
settings-selector-tag-cloud-rows-one = 1 पंक्ति
settings-selector-tag-cloud-rows-two = 2 पंक्तियाँ
settings-selector-tag-cloud-rows-three = 3 पंक्तियाँ
settings-selector-video-preview-card = वीडियो पूर्वावलोकन
settings-selector-video-preview-card-desc = किसी वीडियो पर होवर या चयन करने पर चलता हुआ पूर्वावलोकन।
settings-selector-video-preview-label = वीडियो पूर्वावलोकन चालू करें
settings-selector-video-preview-desc = होवर/चयन पर स्थिर थंबनेल के बजाय वीडियो को ही चलाएँ।
settings-selector-preview-delay-label = पूर्वावलोकन विलंब
settings-selector-preview-delay-desc = होवर/चयन पर पूर्वावलोकन शुरू होने से पहले इतनी देर प्रतीक्षा करें (ms)।
settings-selector-tag-cloud-position-card = खोज पैनल स्थिति
settings-selector-tag-cloud-position-card-desc = खोज पैनल को पिक्सेल में क्षैतिज या ऊर्ध्वाधर दिशा में खिसकाएँ। धनात्मक क्षैतिज ऑफ़सेट उसे दाईं ओर ले जाते हैं; धनात्मक ऊर्ध्वाधर ऑफ़सेट नीचे।
settings-selector-tag-offset-x-label = खोज पैनल क्षैतिज ऑफ़सेट
settings-selector-tag-offset-x-desc = खोज पैनल को इस पिकर के सापेक्ष बाएँ या दाएँ खिसकाएँ।
settings-selector-tag-offset-y-label = खोज पैनल ऊर्ध्वाधर ऑफ़सेट
settings-selector-tag-offset-y-desc = खोज पैनल को इस पिकर के सापेक्ष ऊपर या नीचे खिसकाएँ।
settings-selector-mode-slices = Slices
settings-selector-mode-hex = Geometric
settings-selector-mode-wall = Wall
settings-selector-mode-sandy = Sandy
settings-selector-gpu-tier-discrete = डिस्क्रीट
settings-selector-gpu-tier-integrated = इंटीग्रेटेड
settings-selector-gpu-tier-other = अन्य
settings-selector-swap-style-vortex = भँवर
settings-selector-swap-style-hourglass = रेतघड़ी
settings-selector-swap-style-castle = रेत का महल
settings-selector-swap-style-saltation = उछाल
settings-selector-swap-style-pour = गिलास से उँडेलना
settings-selector-swap-style-orbit = महाभँवर
settings-selector-swap-style-burst = विस्फोट
settings-selector-swap-style-weave = बुनाई
settings-selector-swap-style-bloom = खिलना
settings-selector-swap-style-flock = पक्षी झुंड
settings-selector-swap-style-ring = रिंग
settings-selector-preset-rename-hint = नाम बदलने के लिए कोई स्टाइल चुनें
settings-selector-preset-save-current = वर्तमान सहेजें

settings-selector-mode-hand = पत्तों का हाथ
settings-selector-hand-card = पत्तों का हाथ
settings-selector-hand-card-desc = ताश के पत्तों की तरह हाथ में थामे लंबे कार्डों का पंखा, परिप्रेक्ष्य में। हाथ झुकाने के लिए पॉइंटर हिलाएँ, घुमाने के लिए स्टेज खींचें, और अगला हाथ बाँटने के लिए किनारे से आगे स्क्रॉल करें।
settings-selector-hand-move-label = बाँटने की चाल
settings-selector-hand-move-desc = कार्ड कैसे उड़कर बाहर जाते हैं और अगला हाथ कैसे अंदर आता है। चक्र चालू चालों को क्रम से चलाता है; यादृच्छिक हर बाँट पर उनमें से एक चुनता है। किसी चाल को छोड़ने के लिए उसे नीचे बंद करें।
settings-selector-hand-move-random = यादृच्छिक
settings-selector-hand-move-cycle = चक्र
settings-selector-hand-move-corkscrew = पेचदार
settings-selector-hand-move-cascade = झरना
settings-selector-hand-move-shuffle = फेंटना
settings-selector-hand-move-ribbon = रिबन
settings-selector-hand-move-spiral = सर्पिल
settings-selector-hand-count-label = हाथ में कार्ड
settings-selector-hand-count-desc = एक साथ दिखने वाले कार्ड, 3 से 9 तक।
settings-selector-hand-card-width-label = कार्ड चौड़ाई
settings-selector-hand-card-height-label = कार्ड ऊँचाई
settings-selector-hand-spread-label = पंखे का फैलाव
settings-selector-hand-spread-desc = पड़ोसी कार्डों के बीच क्षैतिज दूरी। आकार 1440 x 900 स्टेज पर डिज़ाइन पिक्सेल में हैं और स्क्रीन के साथ स्केल होते हैं।
settings-selector-hand-perspective-label = परिप्रेक्ष्य
settings-selector-hand-perspective-desc = कैमरे की दूरी। कम मान गहराई को बढ़ा-चढ़ाकर दिखाते हैं।
settings-selector-hand-tilt-label = पॉइंटर झुकाव
settings-selector-hand-tilt-desc = पूरा हाथ पॉइंटर की ओर कितना झुके। 0 झुकाव बंद करता है।
settings-selector-hand-speed-label = गति
settings-selector-hand-speed-desc = बाँटने और फ़्लिप की गति, 100 = डिफ़ॉल्ट।
settings-selector-ribbons-card = रिबन
settings-selector-ribbons-card-desc = हर कार्ड रिबनों में कटा होता है, जो कार्ड फ़्लिप होने पर एक-एक करके खुलते हैं और रिबन बाँट में अलग-अलग उड़ते हैं।
settings-selector-hand-ribbon-axis-label = कटाई की दिशा
settings-selector-hand-ribbon-axis-rows = पंक्तियाँ
settings-selector-hand-ribbon-axis-columns = स्तंभ
settings-selector-hand-ribbons-label = रिबन
settings-selector-hand-ribbons-desc = प्रति कार्ड रिबनों की संख्या, 2 से 14 तक।
settings-selector-hand-cut-label = कटाई का कोण
settings-selector-hand-cut-straight = सीधा
settings-selector-hand-cut-slant = तिरछा
settings-selector-hand-cut-steep = तीखा
settings-selector-hand-cut-variance-label = कटाई में विविधता
settings-selector-hand-cut-variance-desc = हर कार्ड पर रिबन की चौड़ाई और कोण यादृच्छिक करें।
settings-selector-hand-cut-variance-none = एकसमान
settings-selector-hand-cut-variance-soft = हल्की
settings-selector-hand-cut-variance-wild = तीव्र
settings-selector-hand-effects-card = वातावरण
settings-selector-hand-effects-card-desc = हाथ के चारों ओर वैकल्पिक परतें।
settings-selector-hand-ghosts-label = छाया निशान
settings-selector-hand-ghosts-desc = बाँटते समय हर कार्ड के पीछे धुँधली, चमकीली प्रतियाँ चलती हैं।
settings-selector-hand-backdrop-label = धुँधली पृष्ठभूमि
settings-selector-hand-backdrop-desc = हाथ के पीछे स्क्रीन को चुने हुए वॉलपेपर की गहरी, धुँधली प्रति से भरें।
settings-selector-hand-bob-label = निष्क्रिय हिलना
settings-selector-hand-bob-desc = पिकर खुला रहते हुए कार्ड धीरे-धीरे हिलते रहते हैं। इससे पिकर एनिमेट होता रहता है, इसलिए निष्क्रिय रहने पर भी GPU समय लगता है।
settings-selector-hand-fan-angle-label = पंखे का कोण
settings-selector-hand-fan-angle-desc = केंद्र से दूर हर कार्ड पर जोड़ा गया घुमाव। 0 हर कार्ड को आपकी ओर रखता है।
settings-selector-hand-fan-roll-label = पंखे का झुकाव
settings-selector-hand-fan-roll-desc = हर कार्ड पर जोड़ा गया झुकाव, जैसे हाथ में फैले पत्ते। 0 उन्हें सीधा रखता है।
settings-selector-hand-arch-label = मेहराब
settings-selector-hand-arch-desc = बाहरी कार्ड केंद्र वाले कार्ड से कितना नीचे उतरें।
settings-selector-hand-corner-radius-label = कोने की त्रिज्या
settings-selector-hand-skew-label = तिरछापन
settings-selector-hand-skew-desc = कार्ड की रूपरेखा को समांतर चतुर्भुज में तिरछा करें, क्षैतिज ऑफ़सेट के पिक्सेल में।
settings-selector-hand-backdrop-blur-label = पृष्ठभूमि धुँधलापन
settings-selector-hand-backdrop-blur-desc = पृष्ठभूमि के धुँधलेपन की त्रिज्या, 100 = डिफ़ॉल्ट।
settings-selector-hand-reveal-fill-label = पूर्वावलोकन फ़्रेम भरता है
settings-selector-hand-reveal-fill-desc = जब हाथ पलटकर पूर्वावलोकन दिखाता है, तो कार्ड खिंचकर पूरे आकार की तस्वीर बनाते हैं। बंद होने पर हर कार्ड अपनी चौड़ाई और ऊँचाई रखता है और पंक्ति समाने के लिए छोटी-बड़ी होती है।

settings-selector-start-position-label = आरंभिक स्थिति
settings-selector-start-position-desc = शुरुआत से, आपके अंतिम लागू किए वॉलपेपर से, या जहाँ आपने ब्राउज़ करना रोका था वहाँ से खोलें। वर्तमान फ़िल्टर उपयोग करता है।
settings-selector-start-position-beginning = शुरुआत
settings-selector-start-position-applied = अंतिम लागू वॉलपेपर
settings-selector-start-position-browsing = अंतिम ब्राउज़िंग स्थिति

settings-selector-mode-depth = Depth
settings-selector-depth-card = Depth cards
settings-selector-depth-desc = Cards shrink toward the edges. As you scroll, artwork shifts inside each card according to its position in the row.

settings-selector-parallax-label = Image parallax
settings-selector-parallax-desc = Shift artwork inside each card as it moves across the view. The image keeps moving through the visible edges.
settings-selector-mode-collection = संग्रह
settings-selector-collection-desc = माउस व्हील या तीर कुंजियों से झुके हुए कार्ड देखें। कार्ड बड़ा करने के लिए क्लिक करें; वापस जाने के लिए फिर क्लिक करें या Escape दबाएँ। लागू करने के लिए Enter दबाएँ। विवरण के लिए राइट-क्लिक करें।

settings-selector-depth-height-label = Card height
settings-selector-depth-height-desc = Height of the centre card. Large cards shrink to fit the screen.

settings-selector-depth-width-label = Card width
settings-selector-depth-width-desc = Width of the centre card in pixels.

settings-selector-depth-spacing-label = Card spacing
settings-selector-depth-spacing-desc = Distance between card centres in pixels before depth falloff.

settings-selector-depth-count-label = Visible cards
settings-selector-depth-count-desc = Maximum number of cards around the current selection.

settings-selector-depth-falloff-label = Depth falloff
settings-selector-depth-falloff-desc = Scale reduction per card away from the centre, from 0 to 1. Zero keeps their sizes equal.

settings-selector-depth-corners-label = Corner radius
settings-selector-depth-corners-desc = Round the card corners. Zero keeps square corners.

settings-selector-depth-skew-label = Card skew
settings-selector-depth-skew-desc = Slant the card edges. Zero keeps them upright.

settings-selector-depth-speed-label = Navigation duration
settings-selector-depth-speed-desc = Time for a navigation movement in milliseconds. Lower values move faster.

settings-selector-collection-size-label = Card size
settings-selector-collection-size-desc = Card width as a percentage of screen height.

settings-selector-collection-spacing-label = Stack spacing
settings-selector-collection-spacing-desc = Vertical distance between stacked cards as a percentage of card size.

settings-selector-collection-count-label = Visible cards
settings-selector-collection-count-desc = Maximum number of cards in the stack.

settings-selector-collection-tilt-label = Stack tilt
settings-selector-collection-tilt-desc = Tilt the stack away from you. Zero shows the cards face-on.

settings-selector-collection-corners-label = Corner radius
settings-selector-collection-corners-desc = Round the card corners. Zero keeps square corners.

settings-selector-collection-speed-label = Motion speed
settings-selector-collection-speed-desc = Speed of navigation and opening or closing a card. Higher values move faster.

settings-selector-depth-frame-label = Selection frame
settings-selector-depth-frame-desc = Draw a highlighted border around the selected card.

settings-selector-shadows-label = Card shadows
settings-selector-shadows-desc = Draw a shadow behind each card.
