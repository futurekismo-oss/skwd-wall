settings-filter-appearance-card = ظاهر
settings-filter-appearance-card-desc = نوار فیلتر را با چیدمان هر انتخابگر هماهنگ کنید یا همه‌جا یک سبک را به کار ببرید.
settings-filter-visual-style-label = سبک ظاهری
settings-filter-visual-style-desc = «هماهنگ با انتخابگر» در برش‌ها و شنی نوار مورب، در هندسی نوار هندسی و در دیوار نوار صاف را به کار می‌برد.
settings-filter-visual-style-match = هماهنگ با انتخابگر
settings-filter-visual-style-slices = برش‌ها
settings-filter-visual-style-hex = هندسی
settings-filter-visual-style-wall = دیوار
settings-filter-orientation-label = جهت
settings-filter-orientation-desc = کنترل‌های فیلتر را بالای انتخابگر یا در ستونی عمودی کنار آن بگذارید.
settings-filter-orientation-horizontal = افقی
settings-filter-orientation-vertical = عمودی
settings-filter-type-chips-card = نشان‌های نوع
settings-filter-type-chips-card-desc = نشان‌های هر نوع کاغذدیواری را جداگانه نشان دهید یا پنهان کنید.
settings-filter-type-images = تصویرها
settings-filter-type-videos = ویدیوها
settings-filter-type-we = Wallpaper Engine
settings-filter-type-all = همه
settings-filter-sort-options-card = گزینه‌های مرتب‌سازی
settings-filter-sort-options-card-desc = دکمه‌های مرتب‌سازی را جداگانه نشان دهید یا پنهان کنید.
settings-filter-other-controls-card = کنترل‌های دیگر
settings-filter-other-controls-card-desc = بقیهٔ کنترل‌های نوار فیلتر را نشان دهید یا پنهان کنید.
settings-filter-show-folder-label = فیلتر پوشه
settings-filter-show-folder-desc = وقتی پوشهٔ کاغذدیواری زیرفولدر دارد، فهرست کشویی پوشه نشان دهید.
settings-filter-show-favourites-label = برگزیده‌ها
settings-filter-show-favourites-desc = دکمهٔ محدود کردن نتایج به برگزیده‌ها را نشان دهید.
settings-filter-show-random-label = چرخش تصادفی
settings-filter-show-random-desc = دکمهٔ آغاز یا توقف چرخش تصادفی را نشان دهید.
settings-filter-show-colors-label = فیلترهای رنگ
settings-filter-show-colors-desc = نمونه‌رنگ‌های فیلتر بر اساس رنگ غالب کاغذدیواری را نشان دهید.
settings-filter-show-theme-label = تغییر پوسته
settings-filter-show-theme-desc = دکمه‌های پوستهٔ روشن و تیره را نشان دهید.
settings-filter-show-tag-cloud-label = دکمهٔ جستجو
settings-filter-show-tag-cloud-desc = دکمهٔ باز کردن جستجوی برچسب و توصیف را نشان دهید.
settings-filter-show-resolution-label = فیلتر وضوح
settings-filter-show-resolution-desc = وقتی تنظیمات آماده وجود دارد، دکمهٔ چرخشی بازهٔ وضوح را نشان دهید.
settings-filter-resolution-presets-card = بازه‌های آمادهٔ وضوح
settings-filter-resolution-presets-card-desc = هر بازهٔ آماده یک گزینه در دکمهٔ «اندازه» نوار فیلتر می‌شود. با بازه‌ای آشنا شروع کنید و فقط وقتی به بازهٔ سفارشی نیاز داشتید آن را تغییر دهید.
settings-filter-resolution-add-label = افزودن بازهٔ اندازه
settings-filter-resolution-add-desc = اندازه‌ای انتخاب کنید تا بازهٔ آماده‌ای افزوده شود. برای تغییر جهت، نام یا بازهٔ سفارشی آن را باز کنید.
settings-filter-resolution-band-fhd = 1080p
settings-filter-resolution-band-qhd = 1440p
settings-filter-resolution-band-4k = 4K
settings-filter-resolution-band-5k = 5K
settings-filter-resolution-band-8k = 8K+
settings-filter-resolution-band-custom = بازهٔ سفارشی
settings-filter-preset-item-label = تنظیم آمادهٔ { $index }
settings-filter-preset-item-desc = برای ویرایش نام و بازهٔ وضوح باز کنید.
settings-filter-preset-label-label = نام در دکمهٔ اندازه
settings-filter-preset-name-desc = نام کوتاهی که در نوار فیلتر نشان داده می‌شود، مانند FHD یا 2K یا 4K.
settings-filter-preset-name-placeholder = مثلاً 4K
settings-filter-preset-orientation-label = جهت
settings-filter-preset-orientation-desc = این تنظیم آماده را فقط برای کاغذدیواری‌های عریض یا بلند نشان دهید.
settings-filter-preset-orientation-wide = عریض
settings-filter-preset-orientation-tall = بلند
settings-filter-preset-from-label = کمترین اندازه
settings-filter-preset-from-desc = کمترین پهنا و ارتفاعی که در این بازه قرار می‌گیرد.
settings-filter-preset-to-label = بیشترین اندازه
settings-filter-preset-to-desc = بیشترین پهنا و ارتفاع. برای نداشتن سقف، هر دو کادر را خالی بگذارید.
settings-filter-preset-resolution-width-placeholder = پهنا
settings-filter-preset-resolution-height-placeholder = ارتفاع
settings-filter-resolution-unlimited = بدون سقف
settings-filter-resolution-set-limit = تعیین بیشینه
settings-filter-resolution-clear-limit = برداشتن بیشینه
settings-filter-resolution-invalid = دو اندازهٔ مثبت وارد کنید. بیشینه باید در هر دو بُعد دست‌کم برابر کمینه باشد. آخرین بازهٔ معتبر فعال می‌ماند.
settings-filter-resolution-custom-desc = کمترین و بیشترین اندازه را به پیکسل تعیین کنید. هر دو بُعد باید در بازه باشند.
settings-filter-preset-remove-desc = این بازهٔ آمادهٔ وضوح را حذف کنید.
settings-filter-remove-action = حذف
settings-filter-default-folder-card = پوشهٔ پیش‌فرض
settings-filter-default-folder-card-desc = پوشه‌ای که هنگام باز شدن انتخابگر نشان داده می‌شود. همچنان می‌توانید آن را در نوار تغییر دهید.
settings-filter-default-folder-label = پوشه
settings-filter-default-folder-desc = «همهٔ پوشه‌ها» همه‌چیز را نشان می‌دهد؛ برای فیلتر پیش‌فرض یکی را انتخاب کنید.
settings-filter-all-folders = همهٔ پوشه‌ها
settings-filter-main-folder = اصلی
settings-filter-sticky-label = ماندگاری فیلترها
settings-filter-sticky-desc = فیلترهای نوع، پوشه، رنگ، ترتیب و برگزیده را پس از بسته شدن انتخابگر نگه دارید. پوشهٔ به‌یادمانده بر پیش‌فرض بالا اولویت دارد.
settings-filter-position-card = جای نوار فیلتر
settings-filter-position-card-desc = نوار فیلتر را به پیکسل، افقی یا عمودی جابه‌جا کنید. جابه‌جایی افقی مثبت آن را به راست و عمودی مثبت آن را به پایین می‌برد.
settings-filter-offset-x-label = جابه‌جایی افقی نوار فیلتر
settings-filter-offset-x-desc = نوار فیلتر را نسبت به این انتخابگر به چپ یا راست ببرید.
settings-filter-offset-y-label = جابه‌جایی عمودی نوار فیلتر
settings-filter-offset-y-desc = نوار فیلتر را نسبت به این انتخابگر بالا یا پایین ببرید.
settings-filter-visibility-card = نمایش
settings-filter-visibility-card-desc = نوارها را باز نگه دارید تا خودکار پنهان نشوند.
settings-filter-always-visible-label = نمایش همیشگی نوار فیلتر
settings-filter-always-visible-desc = نوار فیلتر را به‌جای پنهان شدن خودکار، همیشه نمایان نگه دارید.
settings-filter-weather-card = فیلتر آب‌وهوا
settings-filter-weather-card-desc = کاغذدیواری‌ها را با آب‌وهوای فعلی محل شما تطبیق دهید.
settings-filter-weather-label = تطبیق با آب‌وهوای فعلی
settings-filter-weather-desc = هنگام باز شدن انتخابگر، آب‌وهوا را از Open-Meteo بگیرید و کاغذدیواری‌های دارای برچسب آب‌وهوای مطابق را نشان دهید. حالت خاموش همه را نشان می‌دهد.
settings-filter-location-label = موقعیت مکانی
settings-filter-location-desc = نام شهر برای دریافت آب‌وهوای فعلی (مثلاً London). برای استفاده از عرض/طول جغرافیایی زبانهٔ زمان‌بندی، خالی بگذارید.
settings-filter-location-placeholder = مثلاً تهران
settings-filter-show-shape-label = فیلتر شکل
settings-filter-show-shape-desc = دکمهٔ فیلتر کاغذدیواری بر اساس شکل را نشان دهید.
settings-filter-show-playlists-label = دکمهٔ فهرست پخش
settings-filter-show-playlists-desc = دکمهٔ باز کردن فهرست‌های پخش را نشان دهید.
settings-filter-show-download-label = دکمهٔ بارگیری
settings-filter-show-download-desc = وقتی منبعی فعال است، دکمهٔ باز کردن بارگیری کاغذدیواری را نشان دهید.
