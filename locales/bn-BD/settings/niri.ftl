settings-niri-backdrop-card = Niri
settings-niri-backdrop-card-desc = আলাদা পটভূমি রাখুন অথবা একটি স্থির ওয়ালপেপার ব্যবহার করুন যা শুধু ওভারভিউতে ঝাপসা হয়।
settings-niri-show-label = ওভারভিউতে ওয়ালপেপার দেখান
settings-niri-show-desc = আলাদা পটভূমি রাখুন অথবা একটি স্থির ওয়ালপেপার ব্যবহার করুন যা শুধু ওভারভিউতে ঝাপসা হয়।
settings-niri-blur-static-label = ছবি ঝাপসা করুন
settings-niri-blur-static-desc = ছবির ব্যাকড্রপ লোড হওয়ার সময় একবার ঝাপসা করে। ওভারভিউ খোলা থাকাকালীন এতে প্রায় কোনো খরচ নেই।
settings-niri-blur-static-radius-label = ছবির ঝাপসা ব্যাসার্ধ
settings-niri-blur-static-radius-desc = ছবির ব্যাকড্রপের ঝাপসা ব্যাসার্ধ, 0 থেকে 100। বেশি মানে আরও নরম।
settings-niri-blur-video-label = ভিডিও ঝাপসা করুন
settings-niri-blur-video-desc = ওভারভিউ খোলা থাকাকালীন ভিডিওর প্রতিটি ফ্রেম ঝাপসা করে। স্পষ্ট ভিডিওর চেয়ে লক্ষণীয়ভাবে বেশি GPU ব্যবহার করে, বিশেষ করে 4K-এ।
settings-niri-blur-video-radius-label = ভিডিওর ঝাপসা ব্যাসার্ধ
settings-niri-blur-video-radius-desc = ভিডিও ব্যাকড্রপের ঝাপসা ব্যাসার্ধ, 0 থেকে 100। বেশি মানে আরও নরম।
settings-niri-blur-we-label = Wallpaper Engine দৃশ্য ঝাপসা করুন
settings-niri-blur-we-desc = ওভারভিউ খোলা থাকাকালীন দৃশ্যের প্রতিটি ফ্রেম ঝাপসা করে। স্পষ্ট দৃশ্যের চেয়ে লক্ষণীয়ভাবে বেশি GPU ব্যবহার করে।
settings-niri-blur-we-radius-label = Wallpaper Engine ঝাপসা ব্যাসার্ধ
settings-niri-blur-we-radius-desc = Wallpaper Engine ব্যাকড্রপের ঝাপসা ব্যাসার্ধ, 0 থেকে 100। বেশি মানে আরও নরম।
settings-niri-follow-label = সবসময় বর্তমান ওয়ালপেপার ব্যবহার করুন
settings-niri-follow-desc = আপনি যে ওয়ালপেপার প্রয়োগ করেন সেটি অনুসরণ করুন। নিচে আলাদা ব্যাকড্রপ বেছে নিতে এটি বন্ধ করুন।
settings-niri-image-label = ব্যাকড্রপ সোর্স
settings-niri-image-desc = কোনো ওয়ালপেপারে ব্যাকড্রপ হিসেবে সেট করুন বেছে নিন, অথবা একটি ছবি, ভিডিও বা Wallpaper Engine প্রজেক্টের পাথ লিখুন। শেষ ওয়ালপেপার ব্যবহার করতে খালি রাখুন।
settings-niri-auto-theme-label = ব্যাকড্রপ স্বয়ংক্রিয়ভাবে থিম করুন
settings-niri-auto-theme-desc = স্থির ছবিগুলোকে একটি gowall থিম প্যালেট দিয়ে নতুন রং দিন। ভিডিও ও Wallpaper Engine সিন তাদের আসল রং রাখে।
settings-niri-theme-label = ব্যাকড্রপ থিম
settings-niri-theme-desc = ব্যাকড্রপ স্বয়ংক্রিয়ভাবে থিম করার সময় ব্যবহৃত প্যালেট।
settings-niri-dim-label = ব্যাকড্রপ আবছা করা
settings-niri-dim-desc = ওভারভিউ ব্যাকড্রপ অন্ধকার করুন। 0 = কিছু না, 100 = কালো।
settings-niri-rule-label = প্রয়োজনীয় niri layer-rule
settings-niri-rule-desc = লেয়ারের নিয়মগুলো ~/.config/niri/config.kdl-এ যোগ করুন। layout ও overview সেটিংস বিদ্যমান ব্লকে যুক্ত করুন।
settings-niri-refresh-label = এখনই ব্যাকড্রপ রিফ্রেশ করুন
settings-niri-refresh-desc = বর্তমান ব্লার, আবছা করা ও থিম সেটিংস দিয়ে নির্বাচিত সোর্স আবার লোড করুন।
settings-niri-refresh-action = রিফ্রেশ
settings-niri-copy-label = layer-rule ক্লিপবোর্ডে কপি করুন
settings-niri-copy-desc = niri-র কনফিগের জন্য উপরের স্নিপেটটি কপি করে।
settings-niri-copy-action = কপি

settings-niri-mode-label = ওভারভিউ মোড
settings-niri-mode-desc = আলাদা পটভূমি রাখুন অথবা একটি স্থির ওয়ালপেপার ব্যবহার করুন যা শুধু ওভারভিউতে ঝাপসা হয়।
settings-niri-mode-separate = আলাদা পটভূমি
settings-niri-mode-stationary = স্থির ওয়ালপেপার
settings-niri-stationary-desc = বর্তমান ওয়ালপেপার ও ডিফল্ট ভিডিও রেন্ডারার ব্যবহার করে। নিচের Niri কনফিগারেশন যোগ করুন। ঝাপসা ও অন্ধকার করা শুধু ওভারভিউতে প্রযোজ্য।
